{
  "name": "clibbits",
  "displayName": "Clibbits",
  "description": "Control your context, control your life",
  "version": "3.15.0",
  "publisher": "codeontherocks",
  "icon": "clibbits.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jtmuller5/clibbits"
  },
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.93.0"
  },
  "activationEvents": [
    "onCommand:clibbits.copyAllFiles",
    "onCommand:clibbits.copyAllFilesWithoutComments",
    "onCommand:clibbits.copyFile",
    "onCommand:clibbits.copyCodeBlock",
    "onCommand:clibbits.copyFolderRecursive",
    "onCommand:clibbits.copyFolderHighlightsRecursive",
    "onCommand:clibbits.copyWithoutComments",
    "onCommand:clibbits.copyTreeStructure",
    "onCommand:clibbits.copyFileHighlights",
    "onCommand:clibbits.createClibbit",
    "onCommand:clibbits.addToClibbit",
    "onCommand:clibbits.addToClibbit.file",
    "onCommand:clibbits.pasteAsFiles",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clibbits.copyAllFiles",
        "title": "Copy Open Files for AI",
        "icon": {
          "light": "./resources/light/file-stack.svg",
          "dark": "./resources/dark/file-stack.svg"
        }
      },
      {
        "command": "clibbits.copyAllFilesWithoutComments",
        "title": "Copy All Open Files Without Comments to Clipboard",
        "icon": {
          "light": "./resources/light/copy-minus.svg",
          "dark": "./resources/dark/copy-minus.svg"
        }
      },
      {
        "command": "clibbits.copyFile",
        "title": "Copy for AI",
        "icon": {
          "light": "./resources/light/copy.svg",
          "dark": "./resources/dark/copy.svg"
        }
      },
      {
        "command": "clibbits.copyCodeBlock",
        "title": "Copy Code Block for AI",
        "icon": "$(copy)"
      },
      {
        "command": "clibbits.copyFolderRecursive",
        "title": "Copy for AI",
        "icon": "$(copy)"
      },
      {
        "command": "clibbits.copyFolderHighlightsRecursive",
        "title": "Copy Highlights for AI",
        "icon": "$(copy)"
      },
      {
        "command": "clibbits.copyWithoutComments",
        "title": "Copy Without Comments",
        "icon": {
          "light": "./resources/light/copy-minus.svg",
          "dark": "./resources/dark/copy-minus.svg"
        }
      },
      {
        "command": "clibbits.copyTreeStructure",
        "title": "Copy Tree Structure"
      },
      {
        "command": "clibbits.createClibbitFolder",
        "title": "Create Clibbits Folder",
        "category": "Clibbits"
      },
      {
        "command": "clibbits.createClibbit",
        "title": "Create Clibbit",
        "category": "Clibbits"
      },
      {
        "command": "clibbits.addToClibbit",
        "title": "Add to Clibbit",
        "category": "Clibbits"
      },
      {
        "command": "clibbits.addToClibbit.file",
        "title": "Add to Clibbit",
        "category": "Clibbits"
      },
      {
        "command": "clibbits.pasteAsFiles",
        "title": "Paste as Files",
        "category": "Clibbits",
        "icon": "$(file-add)"
      },
      {
        "command": "clibbits.copyFileHighlights",
        "title": "Copy Highlights for AI",
        "category": "Clibbits",
        "icon": {
          "light": "./resources/light/locate-fixed.svg",
          "dark": "./resources/dark/locate-fixed.svg"
        }
      },
      {
        "command": "clibbits.showContextServerStatus",
        "title": "Show Context Server Status",
        "category": "Clibbits"
      },
      {
        "command": "clibbits.initializeClibbitConfig",
        "title": "Initialize .clibbits Config",
        "category": "Clibbits"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "clibbits.copyFile",
          "group": "5_cutcopypaste",
          "when": "explorerViewletVisible && !explorerResourceIsFolder"
        },
        {
          "command": "clibbits.copyFileHighlights",
          "group": "5_cutcopypaste",
          "when": "explorerViewletVisible && !explorerResourceIsFolder"
        },
        {
          "command": "clibbits.copyFolderRecursive",
          "group": "5_cutcopypaste",
          "when": "explorerResourceIsFolder"
        },
        {
          "command": "clibbits.copyFolderHighlightsRecursive",
          "group": "5_cutcopypaste",
          "when": "explorerResourceIsFolder"
        },
        {
          "when": "explorerResourceIsFolder || resourceScheme == file",
          "command": "clibbits.copyTreeStructure",
          "group": "clibbits@1"
        },
        {
          "command": "clibbits.addToClibbit.file",
          "group": "5_cutcopypaste",
          "when": "explorerResourceIsFolder || !explorerResourceIsFolder"
        },
        {
          "command": "clibbits.pasteAsFiles",
          "group": "5_cutcopypaste",
          "when": "explorerResourceIsFolder"
        }
      ],
      "editor/context": [
        {
          "command": "clibbits.copyFile",
          "group": "5_cutcopypaste",
          "when": "resourceScheme == file"
        },
        {
          "command": "clibbits.copyWithoutComments",
          "group": "5_cutcopypaste",
          "when": "resourceScheme == file"
        },
        {
          "command": "clibbits.copyFileHighlights",
          "group": "5_cutcopypaste",
          "when": "resourceScheme == file"
        },
        {
          "command": "clibbits.copyCodeBlock",
          "group": "5_cutcopypaste",
          "when": "editorHasSelection"
        },
        {
          "command": "clibbits.copyAllFiles",
          "group": "5_cutcopypaste",
          "when": "editorTextFocus"
        },
        {
          "command": "clibbits.addToClibbit",
          "group": "5_cutcopypaste",
          "when": "editorHasSelection"
        }
      ],
      "editor/title": [
        {
          "command": "clibbits.copyAllFiles",
          "when": "editorIsOpen",
          "group": "navigation",
          "order": 2
        },
        {
          "command": "clibbits.copyFile",
          "when": "editorIsOpen",
          "group": "navigation",
          "order": 1
        },
        {
          "command": "clibbits.copyWithoutComments",
          "when": "editorIsOpen",
          "group": "navigation",
          "order": 1
        },
        {
          "command": "clibbits.copyFileHighlights",
          "when": "editorIsOpen",
          "group": "navigation",
          "order": 1
        }
      ]
    },
    "keybindings": [
      {
        "command": "clibbits.copyAllFiles",
        "key": "ctrl+shift+c",
        "mac": "cmd+shift+c",
        "when": "editorTextFocus"
      },
      {
        "command": "clibbits.copyCodeBlock",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Clibbits",
      "properties": {
        "clibbits.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Enable Code Lens for adding selected code to clibbits"
        },
        "clibbits.contextServer.port": {
          "type": "number",
          "default": 24891,
          "description": "Port for the Clibbits context server (localhost only)"
        },
        "clibbits.contextServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Clibbits context server on activation"
        },
        "clibbits.terminalHistorySize": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of commands to keep in terminal history per terminal"
        },
        "clibbits.terminalMaxOutputBytes": {
          "type": "number",
          "default": 50000,
          "description": "Maximum bytes of output to capture per terminal command"
        },
        "clibbits.configFileName": {
          "type": "string",
          "default": ".clibbits",
          "description": "Name of the project configuration file"
        },
        "clibbits.autoVocabulary": {
          "type": "boolean",
          "default": true,
          "description": "Auto-extract vocabulary from document symbols"
        },
        "clibbits.visibleTextInContext": {
          "type": "boolean",
          "default": true,
          "description": "Include visible editor text in context responses"
        },
        "clibbits.maxRecentFiles": {
          "type": "number",
          "default": 10,
          "description": "Maximum number of recent files to track"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "14.x",
    "@types/vscode": "^1.109.0",
    "@typescript-eslint/eslint-plugin": "^5.1.0",
    "@typescript-eslint/parser": "^5.1.0",
    "eslint": "^8.1.0",
    "typescript": "^4.4.4"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "yaml": "^2.3.1"
  }
}
